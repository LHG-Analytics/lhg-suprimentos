# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example é comitado, .env.local nunca
.env.local
.env.production.local
.env.development.local
.env.test.local

# Service Account keys do Google — NUNCA commitar
*-service-account*.json
*serviceaccount*.json
*service_account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code / design brief — arquivos locais (não commitar)
CLAUDE.md
AGENTS.md

# Claude Code — configurações locais (tokens, MCP, permissões)
.claude/settings.local.json

# Playwright MCP — dados locais de sessão do browser
.playwright-mcp/

# Design handoff e referências locais (arquivos soltos na raiz)
prototype/
docs/*.pdf
docs/*.fig
# Specs e planos do superpowers são commitados (docs/superpowers/)
lhg-suprimentos-kickoff.md
supabase/.temp/

.vercel
